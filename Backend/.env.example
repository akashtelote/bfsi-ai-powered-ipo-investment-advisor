# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# EPAM Dial API — used by GET /api/live/lookup for IPO detail auto-fill
DIAL_API_URL=https://your-dial-instance.epam.com/openai
DIAL_API_KEY=your-api-key-here
DIAL_MODEL=gpt-4o

# Database (default: SQLite in backend/data/)
# DATABASE_URL=sqlite+aiosqlite:///./data/ipo_advisor.db

# ML models directory (default: repo_root/ml/models/)
# ML_MODELS_DIR=/app/ml_models

# IPOALERTS_API_KEY
IPOALERTS_API_KEY=<IPOALERTS_API_KEY>